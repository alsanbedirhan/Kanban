@model Kanban.Services.ServiceResult<InviteStatus>
@inject IConfiguration Configuration
@{
    Layout = null;
    var turnstileSiteKey = Configuration["TurnstileSettings:SiteKey"] ?? "";
}
<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>kanflow</title>
    <meta name="description" content="Manage projects effortlessly with Kanflow. Organize tasks, collaborate with your team, and boost productivity. The fast, secure, and free Kanban tool." />
    <meta name="keywords" content="kanban, project management, task tracking, agile, scrum, workflow, productivity, kanflow, bedirhan alşan, bedirhan alsan, todo list" />
    <meta name="author" content="Bedirhan Alsan" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.kanflow.online/" />
    <meta property="og:title" content="Kanflow - Streamline Your Workflow" />
    <meta property="og:description" content="The modern way to manage tasks. Create boards, invite your team, and get things done. Simple, fast, and effective." />
    <meta property="og:image" content="https://www.kanflow.online/logo.png" />
    <meta property="og:image:alt" content="Kanflow Dashboard Preview" />
    <meta property="og:site_name" content="Kanflow" />
    <meta property="og:locale" content="en_US" />
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#289f51">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Kanflow">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
    <script src="https://cdn.quilljs.com/1.3.6/quill.js" defer></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js' defer></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
    <div id="server-data" class="u-hidden"
         data-invite-status="@Model.Data.ToString()"
         data-server-message="@Model.ErrorMessage">
    </div>
    <button class="menu-toggle" data-action="toggleSidebar" aria-label="Open menu" aria-expanded="false">☰</button>
    <div class="sidebar-overlay" id="sidebarOverlay" data-action="toggleSidebar" aria-hidden="true"></div>
    <aside class="sidebar" id="sidebar" aria-label="Board navigation">
        <div class="sidebar-header">
            <h2>kanflow.online</h2>
            <button class="close-sidebar-btn" data-action="toggleSidebar" aria-label="Close menu">×</button>
        </div>
        <div class="sidebar-content">
            <div class="sidebar-board-action">
                <button type="button" class="add-board-btn" data-action="openNewBoardModal">
                    ➕ New Board
                </button>
            </div>
            <div class="sidebar-section-title">📋 My Boards</div>
            <ul class="board-list" id="boardList"></ul>
            <div class="sidebar-section-title">📋 Shared With Me</div>
            <ul class="board-list" id="sharedBoardList"></ul>
        </div>
        <div class="sidebar-footer" id="authSection"></div>
        <div class="developer-footer">
            Developed by <a href="https://bedirhanalsan.com" target="_blank" rel="noopener">Bedirhan Alşan</a>
        </div>
    </aside>
    <main class="container">
        <div class="header" id="kanflowheader">
            <h1 class="brand-title" id="kanflowheadertitle">
                <img src="/favicon.svg" alt="Kanflow Logo" class="brand-logo">
                kanflow
            </h1>
            <div class="header-actions" id="authHeaderArea"></div>
        </div>
        <div class="header secondary-header u-hidden" id="boardHeader">
            <div class="board-header-row">
                <h1 id="boardHeaderTitle"></h1>
                <div class="board-search-wrap" id="boardSearchWrap">
                    <input type="search" id="boardSearchInput" class="board-search-input"
                           placeholder="Search cards… (/)" aria-label="Search cards" autocomplete="off">
                    <button type="button" id="boardSearchClear" class="board-search-clear" data-action="clearBoardSearch"
                            hidden aria-label="Clear search">×</button>
                </div>
                <div class="board-toolbar">
                    <button type="button" class="btn btn-secondary btn-icon board-search-toggle" id="boardSearchToggleBtn"
                            data-action="toggleBoardSearch" title="Search cards" aria-label="Search cards" aria-expanded="false">🔍</button>
                    <button type="button" class="btn btn-secondary btn-icon" data-action="changeView"
                            title="Calendar view" aria-label="Calendar view">📅</button>
                    <button type="button" class="btn btn-primary btn-icon" id="btnNewColumn" data-action="openNewColumnModal"
                            title="Add column" aria-label="Add column">➕</button>
                </div>
            </div>
        </div>
        <div class="board" id="board"></div>
        <div id="calendar" class="calendar-panel u-hidden"></div>
    </main>
    <form class="modal" id="loginModal" role="dialog" aria-modal="true" aria-labelledby="loginModalTitle">
        <div class="modal-content">
            <h3 id="loginModalTitle">Login</h3>
            <div class="form-group">
                <label for="loginEmail">Email</label>
                <input type="email" id="loginEmail" placeholder="your@email.com" autocomplete="email">
            </div>
            <div class="form-group">
                <label for="loginPassword">Password</label>
                <input type="password" id="loginPassword" placeholder="••••••••" autocomplete="current-password">
                <button type="button" tabindex="-1" class="toggle-password" data-target="loginPassword" aria-label="Show password">🙈</button>
            </div>
            <div class="turnstile-wrap">
                <div class="turnstile-stage">
                    <div id="turnstile-container-login" class="turnstile-container" data-sitekey="@turnstileSiteKey"></div>
                    <div class="turnstile-skeleton" aria-hidden="true">
                        <span>Loading verification...</span>
                    </div>
                    <div class="turnstile-error" role="alert"></div>
                </div>
                <button type="button" class="turnstile-retry-btn" data-action="retryTurnstile" data-turnstile-target="turnstile-container-login">
                    🔄 Retry verification
                </button>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" data-action="closeLoginModal">Cancel</button>
                <button type="submit" class="btn btn-primary">🔐 Login</button>
            </div>
            <div class="modal-footer-link login-modal-footer">
                <button type="button" class="btn-link" data-action="handleForgotPassword">Forgot password?</button>
                <span class="modal-footer-sep">·</span>
                <span>Don’t have an account? <button type="button" class="btn-link" data-action="switchToRegister">Register</button></span>
            </div>
        </div>
    </form>
    <form class="modal" id="registerModal" role="dialog" aria-modal="true" aria-labelledby="registerModalTitle">
        <div class="modal-content">
            <h3 id="registerModalTitle">Register</h3>
            <div class="form-group">
                <label for="registerFullName">Full Name</label>
                <input type="text" id="registerFullName" placeholder="Your full name" autocomplete="name">
            </div>
            <div class="form-group">
                <label for="registerEmail">Email</label>
                <input type="email" id="registerEmail" placeholder="your@email.com" autocomplete="email">
            </div>
            <div class="form-group">
                <label for="registerPassword">Password</label>
                <input type="password" id="registerPassword" placeholder="••••••••" autocomplete="new-password">
                <button type="button" tabindex="-1" class="toggle-password" data-target="registerPassword" aria-label="Show password">🙈</button>
            </div>
            <div class="form-group">
                <label for="registerConfirmPassword">Confirm Password</label>
                <input type="password" id="registerConfirmPassword" placeholder="••••••••" autocomplete="new-password">
                <button type="button" tabindex="-1" class="toggle-password" data-target="registerConfirmPassword" aria-label="Show password">🙈</button>
            </div>
            <div class="agreement-row">
                <input type="checkbox" id="registerAgreement">
                <label for="registerAgreement" class="agreement-label">
                    I have read and agree to the
                    <a href="#" data-action="showPrivacyPolicy" class="text-link">Privacy Policy</a> and
                    <a href="#" data-action="showUserAgreement" class="text-link">User Agreement</a>.
                </label>
            </div>
            <div class="turnstile-wrap">
                <div class="turnstile-stage">
                    <div id="turnstile-container-register" class="turnstile-container" data-sitekey="@turnstileSiteKey"></div>
                    <div class="turnstile-skeleton" aria-hidden="true">
                        <span>Loading verification...</span>
                    </div>
                    <div class="turnstile-error" role="alert"></div>
                </div>
                <button type="button" class="turnstile-retry-btn" data-action="retryTurnstile" data-turnstile-target="turnstile-container-register">
                    🔄 Retry verification
                </button>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" data-action="closeRegisterModal">Cancel</button>
                <button type="submit" class="btn btn-primary">📝 Register</button>
            </div>
            <div class="modal-footer-link">
                Already have an account?
                <button type="button" class="btn-link" data-action="switchToLogin">Login</button>
            </div>
        </div>
    </form>
    <div class="modal" id="avatarModal" role="dialog" aria-modal="true" aria-labelledby="avatarModalTitle">
        <div class="modal-content modal-content-centered">
            <h3 id="avatarModalTitle">Select Your Look</h3>
            <p class="modal-subtitle">Choose an avatar to personalize your profile.</p>
            <div id="avatarSelectionArea" class="avatar-grid"></div>
            <button type="button" class="btn btn-primary btn-full" data-action="saveMyAvatar">
                🚀 Let's Go!
            </button>
        </div>
    </div>
    <div id="loadingOverlay" class="loading-overlay" role="status" aria-live="polite" aria-busy="false">
        <div class="spinner" aria-hidden="true"></div>
        <span>Just a moment...</span>
    </div>
    <template id="otpTemplate">
        <div id="otp-inputs" class="otp-container">
            <input type="text" class="otp-field" maxlength="1" inputmode="numeric">
            <input type="text" class="otp-field" maxlength="1" inputmode="numeric">
            <input type="text" class="otp-field" maxlength="1" inputmode="numeric">
            <input type="text" class="otp-field" maxlength="1" inputmode="numeric">
            <input type="text" class="otp-field" maxlength="1" inputmode="numeric">
            <input type="text" class="otp-field" maxlength="1" inputmode="numeric">
        </div>
        <div class="turnstile-wrap turnstile-wrap-otp">
            <div class="turnstile-stage">
                <div id="turnstile-container-otp" class="turnstile-container" data-sitekey="@turnstileSiteKey"></div>
                <div class="turnstile-skeleton" aria-hidden="true">
                    <span>Loading verification...</span>
                </div>
                <div class="turnstile-error" role="alert"></div>
            </div>
            <button type="button" class="turnstile-retry-btn" data-action="retryTurnstile" data-turnstile-target="turnstile-container-otp">
                🔄 Retry verification
            </button>
        </div>
    </template>
    <button type="button" id="quickNoteBtn" class="quick-note-toggle" data-action="toggleQuickNote" aria-label="Quick notes">📝</button>
    <div id="quickNoteContainer" class="quick-note-wrapper">
        <div class="quick-note-header quick-note-header-lg">
            <div class="quick-note-header-left">
                <button type="button" class="quick-note-icon-btn" id="btnOpenNoteTable" title="Note list" aria-label="Note list">☰</button>
                <span>Quick Notes</span>
            </div>
            <div class="quick-note-header-right">
                <button type="button" class="quick-note-icon-btn" id="btnAddNote" title="New note" aria-label="New note">➕</button>
                <button type="button" class="quick-note-icon-btn" data-action="toggleQuickNote" title="Close notes" aria-label="Close notes">✕</button>
            </div>
        </div>
        <div id="noteHeader" class="note-title-bar" title="Click for rename">
            <span id="currentNoteTitle">Loading...</span>
        </div>
        <textarea id="quickNoteArea" placeholder="Write here..." maxlength="1000"></textarea>
        <div class="quick-note-footer">
            <span id="saveStatus" class="save-status">Saved ✅</span>
            <button type="button" id="btnTrash" class="quick-note-icon-btn" title="Clear note">🧹 Clear</button>
        </div>
        <div id="noteListOverlay" class="note-list-overlay">
            <div class="quick-note-header quick-note-header-lg note-list-header">
                <span>My Notes</span>
                <div class="quick-note-header-right">
                    <button type="button" class="quick-note-icon-btn" id="btnAddNote2" title="New note" aria-label="New note">➕</button>
                    <button type="button" class="quick-note-icon-btn" id="btnCloseNoteTable" title="Close list" aria-label="Close list">✕</button>
                </div>
            </div>
            <div class="note-list-body">
                <table class="note-list-table">
                    <tbody id="noteListTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div id="keyboardHints" class="keyboard-hints" aria-hidden="true">
        <kbd>/</kbd> search · <kbd>N</kbd> new card · <kbd>Esc</kbd> close
    </div>
</body>
</html>
